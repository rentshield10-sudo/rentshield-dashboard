      "id": "get-all-rows",
      "name": "Get All Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [420, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const targetAddress = String($('Webhook').first().json.body.address || '').trim().toLowerCase();\nconst targetUnit = String($('Webhook').first().json.body.unit || '').trim().toLowerCase();\n\nconst match = items.find((item) => {\n  const addr = String(item.json['Address'] || '').trim().toLowerCase();\n  const unit = String(item.json['Room Floor'] || '').trim().toLowerCase();\n  return addr === targetAddress && unit === targetUnit;\n});\n\nif (!match) {\n  throw new Error(`No sheet row found matching address \"${targetAddress}\" + unit \"${targetUnit}\"`);\n}\n\nconst body = $('Webhook').first().json.body;\n\nreturn [\n  {\n    json: {\n      rowNumber: match.json.row_number,\n      activation2: body.activation2,\n      expiration2: body.expiration2\n    }\n  }\n];"
      },
      "id": "find-matching-row",
      "name": "Find Matching Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/1i9Q3Bcul0C4tYwfUTHw6dYjKtEq6LGSOMRm4k115UGg/values/Sheet1!F{{ $json.rowNumber }}:G{{ $json.rowNumber }}?valueInputOption=USER_ENTERED",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { values: [ [ $json.activation2, $json.expiration2 ] ] } }}",
        "options": {}
      },
      "id": "write-cells",
      "name": "Write Renewal Dates to F/G",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, updatedRow: $json.updatedRange } }}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
